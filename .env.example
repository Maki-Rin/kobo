KOBO_PRINTER_PUBLIC_API_BASE_URL=https://kobo-printer-control-plane.maki-rin.workers.dev
# File names are removed from the website API by default.
KOBO_PRINTER_PUBLIC_FILE_NAMES=false

# Local editor. Start with npm run dev -- --port 3100.
EDITOR_ORIGIN=http://localhost:3100
EDITOR_SQLITE_PATH=.editor-local/editor.db

# Production: set separately in Vercel, Production environment only.
# EDITOR_ORIGIN=https://kobo-rits.vercel.app
# EDITOR_RATE_LIMIT_SECRET=<random value of at least 32 characters; Vercel Secret>
# CLOUDFLARE_ACCOUNT_ID=
# EDITOR_D1_DATABASE_ID=
# EDITOR_D1_API_TOKEN=<Vercel Secret>
# EDITOR_GITHUB_APP_ID=
# EDITOR_GITHUB_INSTALLATION_ID=
# EDITOR_GITHUB_PRIVATE_KEY=<Vercel Secret; PEM>
# EDITOR_GITHUB_REPO=Maki-Rin/kobo
# EDITOR_GITHUB_BRANCH=main
